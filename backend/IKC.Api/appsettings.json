{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // Tajne vrijednosti (Jwt:Key, ImgBb:ApiKey, Admin:Password, GitHub:Token) NE upisivati ovdje.
  // Lokalno: dotnet user-secrets. Na MonsterASP: appsettings.Production.json (nije u gitu) ili varijable okruženja.
  "Database": {
    "Provider": "SqlServer"
  },
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "Key": "",
    "Issuer": "ikc-api",
    "Audience": "ikc-admin",
    "ExpiresHours": 12
  },
  "ImgBb": {
    "ApiKey": ""
  },
  "Admin": {
    "Username": "admin",
    "Password": ""
  },
  "GitHub": {
    "Repository": "metur100/IKC.Duesseldorf",
    "Token": "",
    "DebounceSeconds": 60
  },
  "Cors": {
    "Origins": [ "https://metur100.github.io" ]
  }
